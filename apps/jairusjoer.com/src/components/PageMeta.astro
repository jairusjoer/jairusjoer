---
import { page } from '@config';
import { getImage } from 'astro:assets';

export interface Metadata {
  title: string;
  description?: string;
  id?: string;
  image?: ImageMetadata;
  status?: string;
}

export interface Props {
  metadata?: Metadata;
}

const { title, description = page.description, id, image, status } = Astro.props.metadata ?? {};

const titleTemplate = title === page.title ? page.title : `${title} • ${page.title}`;

const getURL = (path: string) => String(new URL(path, Astro.site));

const pageImage = image ? getURL(image.src) : getURL(`og/${id ?? 'index'}.png`);
---

<meta charset="utf-8" />
<meta
  name="viewport"
  content="width=device-width, initial-scale=1, viewport-fit=cover"
/>

<meta
  name="generator"
  content={Astro.generator}
/>

<link
  rel="sitemap"
  href="/sitemap-index.xml"
/>

<link
  rel="alternate"
  type="application/rss+xml"
  title={page.title}
  href={new URL('rss.xml', Astro.site)}
/>

{
  page?.image && (
    <>
      <link
        rel="icon"
        href={(await getImage({ src: await page.image(), width: 48, height: 48, format: 'png' })).src}
        sizes="48x48"
      />
      <link
        rel="apple-touch-icon"
        href={(await getImage({ src: await page.image(), width: 180, height: 180, format: 'png' })).src}
      />
    </>
  )
}

<title>{titleTemplate}</title>
<meta
  name="title"
  content={titleTemplate}
/>
<meta
  property="og:title"
  content={titleTemplate}
/>
<meta
  name="twitter:title"
  content={titleTemplate}
/>

{
  description && (
    <>
      <meta
        name="description"
        content={description}
      />
      <meta
        property="og:description"
        content={description}
      />
      <meta
        name="twitter:description"
        content={description}
      />
    </>
  )
}

<meta
  property="og:image"
  content={pageImage}
/>
<meta
  name="twitter:image"
  content={pageImage}
/>

<meta
  property="og:url"
  content={getURL(Astro.url.pathname)}
/>
<meta
  name="twitter:url"
  content={getURL(Astro.url.pathname)}
/>

{
  status === 'Draft' && (
    <meta
      name="robots"
      content="noindex"
    />
  )
}

<meta
  property="og:type"
  content="website"
/>
<meta
  property="og:site_name"
  content={page.title}
/>
<meta
  property="og:locale"
  content={page.locale}
/>
<meta
  name="twitter:card"
  content="summary_large_image"
/>

<link
  rel="canonical"
  href={getURL(Astro.url.pathname)}
/>

<slot />
