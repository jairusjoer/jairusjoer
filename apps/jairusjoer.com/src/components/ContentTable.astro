---
import type { MarkdownHeading } from 'astro';

export interface Props {
  class?: string;
  headings: MarkdownHeading[];
}

const { class: className, headings } = Astro.props;
---

{
  headings.length > 0 && (
    <details class:list={className}>
      <summary>Contents</summary>

      <ol>
        {headings.map(({ depth, slug, text }) => (
          <li style={`--toc-level: ${Math.max(0, depth - 2)}`}>
            <a href={`#${slug}`}>{text}</a>
          </li>
        ))}
      </ol>
    </details>
  )
}

<style>
  ol li {
    margin-inline-start: calc(var(--toc-level, 0) * var(--prose-flow));
  }
</style>
