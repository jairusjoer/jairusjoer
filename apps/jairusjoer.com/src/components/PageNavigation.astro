---
export interface Props {
  class?: string;
  links?: Record<string, string>;
}

const { class: className, links } = Astro.props;

function current(path: string) {
  if (path === '/') {
    return Astro.url.pathname === path;
  } else {
    return Astro.url.pathname.startsWith(path);
  }
}
---

{
  links && (
    <nav class:list={['w-full print:hidden', className]}>
      <ul class="flex flex-wrap items-center gap-6 font-medium">
        <slot />
        {Object.entries(links).map(([title, href]) => (
          <li>
            <a
              class:list={['hover:text-foreground focus:text-foreground block', current(href) && 'text-foreground']}
              href={href}
            >
              {title}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
