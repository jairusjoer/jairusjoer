---
export interface Props {
  class?: string;
  title: string;
  href?: string;
  meta?: Date | string;
  wrap?: boolean;
}

const { class: className, title, href, meta, wrap = true } = Astro.props;
const Container = href ? 'a' : 'div';
---

<Container
  class:list={['rounded-inner not-prose w-full', { 'flex gap-x-3 max-sm:flex-col': wrap }, className]}
  {href}
  title={href ? title : undefined}
>
  <p class:list={['mr-auto font-medium sm:truncate', href ? 'text-accent' : 'text-foreground']}>
    {title}
  </p>

  {meta && <p class="whitespace-nowrap tabular-nums">{meta}</p>}
</Container>
