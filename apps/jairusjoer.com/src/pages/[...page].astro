---
import ContentHeader from '@components/ContentHeader.astro';
import ContentTable from '@components/ContentTable.astro';
import type { Metadata } from '@components/PageMeta.astro';
import PageLayout from '@layouts/PageLayout.astro';
import { isPublished } from '@scripts/isPublished';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  entry: CollectionEntry<'pages'>;
}

export async function getStaticPaths() {
  let collection = await getCollection('pages');

  if (import.meta.env.PROD) {
    collection = collection.filter((entry) => isPublished(entry.data.status));
  }

  return collection.map((entry) => ({
    params: { page: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;

const { Content, headings } = await render(entry);

const metadata: Metadata = {
  id: entry.id,
  title: entry.data.title,
  description: entry.data.description,
  image: entry.data.image,
  status: entry.data.status,
};
---

<PageLayout {metadata}>
  <ContentHeader {entry} />
  <hr class="my-6" />
  <div class="prose">
    <ContentTable {headings} />
    <Content />
  </div>
</PageLayout>
