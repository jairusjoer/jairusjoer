# Required: group whose issues are polled, and the GitLab username to act for
GITLAB_GROUP=my-group/subgroup
ASSIGNEE=my-username
# Opt-in: only issues with this label get agents (empty = every assigned issue)
TRIGGER_LABEL=claude
# Only issues in the current iteration (matches the board filter)
CURRENT_ITERATION_ONLY=true

# Board lists = work item statuses
STATUS_TODO=To do
STATUS_DOING=In progress
STATUS_REVIEW=In Review

POLL_INTERVAL_SEC=30
# Local clones live in REPOS_DIR/<project path>, worktrees in WORKTREES_DIR
REPOS_DIR=~/Git/jjjunior-repos
WORKTREES_DIR=~/Git/jjjunior-worktrees

MAX_ROUNDS=3
MAX_PARALLEL=2
AGENT_TIMEOUT_MIN=60
# Wait for CI after each push; failed jobs' logs go back to the implementer (0 = off)
PIPELINE_TIMEOUT_MIN=45
PERMISSION_MODE=auto
# CLAUDE_MODEL=claude-opus-5-5
