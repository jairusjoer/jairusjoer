{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",

  "primitive": {
    "color": {
      "$type": "color",
      "gray-100": { "$value": "#171414" },
      "gray-90": { "$value": "#272525" },
      "gray-80": { "$value": "#3c3838" },
      "gray-70": { "$value": "#565151" },
      "gray-60": { "$value": "#726e6e" },
      "gray-50": { "$value": "#8f8b8b" },
      "gray-40": { "$value": "#ada8a8" },
      "gray-30": { "$value": "#cac5c4" },
      "gray-20": { "$value": "#e5e0df" },
      "gray-10": { "$value": "#f7f3f2" }
    },
    "space": {
      "$type": "dimension",
      "xs": { "$value": { "value": 0.25, "unit": "rem" } },
      "sm": { "$value": { "value": 0.5, "unit": "rem" } },
      "md": { "$value": { "value": 1, "unit": "rem" } },
      "lg": { "$value": { "value": 2, "unit": "rem" } },
      "xl": { "$value": { "value": 4, "unit": "rem" } }
    },
    "radius": {
      "$type": "dimension",
      "sm": { "$value": { "value": 8, "unit": "rem" } },
      "md": { "$value": { "value": 12, "unit": "rem" } },
      "full": { "$value": { "value": 9999, "unit": "px" } }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "sans": { "$value": ["system-ui", "sans-serif"] },
        "mono": { "$value": ["monospace"] }
      },
      "size": {
        "$type": "dimension",
        "xs": { "$value": { "value": 0.75, "unit": "rem" } },
        "sm": { "$value": { "value": 0.875, "unit": "rem" } },
        "md": { "$value": { "value": 1, "unit": "rem" } },
        "lg": { "$value": { "value": 1.5, "unit": "rem" } },
        "xl": { "$value": { "value": 2, "unit": "rem" } }
      },
      "weight": {
        "$type": "fontWeight",
        "regular": { "$value": 400 },
        "medium": { "$value": 500 }
      }
    }
  },

  "color": {
    "$type": "color",
    "accent-contrast": { "$value": "{primitive.color.gray-10}" },
    "accent": { "$value": "{primitive.color.gray-100}" },
    "background-subtle": { "$value": "{primitive.color.gray-20}" },
    "background": { "$value": "{primitive.color.gray-10}" },
    "border": { "$value": "{primitive.color.gray-30}" },
    "foreground-subtle": { "$value": "{primitive.color.gray-70}" },
    "foreground": { "$value": "{primitive.color.gray-100}" }
  },
  "space": {
    "$type": "dimension",
    "tight": { "$value": "{primitive.space.xs}" },
    "normal": { "$value": "{primitive.space.sm}" },
    "wide": { "$value": "{primitive.space.md}" },
    "xwide": { "$value": "{primitive.space.lg}" }
  },
  "radius": {
    "$type": "dimension",
    "small": { "$value": "{primitive.radius.sm}" },
    "medium": { "$value": "{primitive.radius.md}" }
  },
  "typography": {
    "$type": "typography",
    "heading-xl": {
      "$value": {
        "fontFamily": "{primitive.font.family.sans}",
        "fontSize": "{primitive.font.size.xl}",
        "fontWeight": "{primitive.font.weight.medium}",
        "lineHeight": 1.125,
        "letterSpacing": { "value": 0, "unit": "px" }
      }
    },
    "heading-lg": {
      "$value": {
        "fontFamily": "{primitive.font.family.sans}",
        "fontSize": "{primitive.font.size.lg}",
        "fontWeight": "{primitive.font.weight.medium}",
        "lineHeight": 1.125,
        "letterSpacing": { "value": 0, "unit": "px" }
      }
    },
    "heading-md": {
      "$value": {
        "fontFamily": "{primitive.font.family.sans}",
        "fontSize": "{primitive.font.size.md}",
        "fontWeight": "{primitive.font.weight.medium}",
        "lineHeight": 1.125,
        "letterSpacing": { "value": 0, "unit": "px" }
      }
    },
    "text-md": {
      "$value": {
        "fontFamily": "{primitive.font.family.sans}",
        "fontSize": "{primitive.font.size.md}",
        "fontWeight": "{primitive.font.weight.regular}",
        "lineHeight": 1.5,
        "letterSpacing": { "value": 0, "unit": "px" }
      }
    },
    "text-sm": {
      "$value": {
        "fontFamily": "{primitive.font.family.sans}",
        "fontSize": "{primitive.font.size.md}",
        "fontWeight": "{primitive.font.weight.regular}",
        "lineHeight": 1.5,
        "letterSpacing": { "value": 0, "unit": "px" }
      }
    },
    "text-xs": {
      "$value": {
        "fontFamily": "{primitive.font.family.sans}",
        "fontSize": "{primitive.font.size.xs}",
        "fontWeight": "{primitive.font.weight.regular}",
        "lineHeight": 1.5,
        "letterSpacing": { "value": 0, "unit": "px" }
      }
    }
  }
}
