{
  "name": "workspace",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "targets": {
    "format": {
      "command": "prettier --write --ignore-unknown .",
      "configurations": { "check": { "command": "prettier --check --ignore-unknown ." } }
    },
    "lint": {
      "command": "eslint --fix --no-warn-ignored .",
      "configurations": { "check": { "command": "eslint --no-warn-ignored ." } }
    },
    "typecheck": {
      "command": "tsc -p tsconfig.root.json"
    }
  }
}
